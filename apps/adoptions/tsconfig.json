{
  "compilerOptions": {
    "target": "ESNext",
    "module": "CommonJS",
    "rootDir": "../../",            
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "baseUrl": ".",
    "paths": {
      "@db/*": ["../../packages/db/*"]
    }
  },
  "exclude": [
    "node_modules",
    "dist",
    "tsup.config.ts",
    "*.config.ts",
    "**/*.config.ts"
  ],
  "include": [
    "src/**/*",
    "../../packages/db/**/*"
  ]
}
